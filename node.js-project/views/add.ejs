<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Registration</title>
    <link rel="stylesheet" href="/adding.css">
</head>

<body>

    <% if (message) { %>
        <div class="notification">
            <%= message %>
        </div>
        <% } %>

            <div class="container">
                <div class="form-card">

                    <button type="button" class="back-btn" onclick="goToHome()">
                        ← Back to Users
                    </button>

                    <h1>User Registration</h1>

                    <% if(dataInitial){ %>

                        <form id="userForm" action="/users/edit" method="post">

                            <input type="hidden" value="<%= user._id %>" name="_id" id="hiddenid">

                            <div class="form-group">
                                <label for="name">Name</label>
                                <input type="text" id="name" name="Name" required value="<%= user.Name %>"
                                    data-initial="<%= dataInitial.Name %>">
                            </div>

                            <div class="form-group">
                                <label for="email">Email</label>
                                <input type="email" id="email" name="Email" required value="<%= user.Email %>"
                                    data-initial="<%= dataInitial.Email %>">
                            </div>

                            <div class="form-group">
                                <label for="password">Password</label>
                                <input type="text" id="password" name="Password" required value="<%= user.Password %>"
                                    data-initial="<%= dataInitial.Password %>">
                            </div>

                            <div class="form-group">
                                <label for="contact">Contact Number</label>
                                <input type="text" id="contact" name="Contact_No" required
                                    value="<%= user.Contact_No %>" data-initial="<%= dataInitial.Contact_No %>">
                            </div>

                            <button class="btn" id="submit1" type="submit">
                                Update User
                            </button>

                        </form>

                        <% } else { %>

                            <form id="userForm" action="/users/create" method="post">

                                <div class="form-group">
                                    <label for="name">Name</label>
                                    <input type="text" id="name" name="Name" required value="<%= user.Name %>"
                                        data-initial="<%= user.Name %>">
                                </div>

                                <div class="form-group">
                                    <label for="email">Email</label>
                                    <input type="email" id="email" name="Email" required value="<%= user.Email %>"
                                        data-initial="<%= user.Email %>">
                                </div>

                                <div class="form-group">
                                    <label for="password">Password</label>
                                    <input type="text" id="password" name="Password" required
                                        value="<%= user.Password %>" data-initial="<%= user.Password %>">
                                </div>

                                <div class="form-group">
                                    <label for="contact">Contact Number</label>
                                    <input type="text" id="contact" name="Contact_No" required
                                        value="<%= user.Contact_No %>" data-initial="<%= user.Contact_No %>">
                                </div>

                                <button class="btn" id="submit1" type="submit">
                                    Create User
                                </button>

                            </form>

                            <% } %>

                </div>
            </div>

            <script>

                function goToHome() {
                    window.location.href = "http://localhost:7000/users";
                }
                document.addEventListener("DOMContentLoaded", function () {

                    const hidden = document.getElementById("hiddenid");

                    if (hidden && hidden.value && /^[0-9a-fA-F]{24}$/.test(hidden.value)) {

                        const formInputs = document.querySelectorAll(
                            'input[type="text"], input[type="email"]'
                        );

                        const submitButton = document.getElementById("submit1");

                        const initialValues = Array.from(formInputs).map(
                            input => input.dataset.initial
                        );

                        function checkForChanges() {

                            let hasChanges = false;

                            formInputs.forEach((input, index) => {

                                if (
                                    input.value.trim() !==
                                    initialValues[index].trim()
                                ) {
                                    hasChanges = true;
                                }
                            });

                            submitButton.disabled = !hasChanges;

                            if (!hasChanges) {
                                submitButton.classList.add("disabled-btn");
                            } else {
                                submitButton.classList.remove("disabled-btn");
                            }
                        }

                        checkForChanges();

                        formInputs.forEach(input => {
                            input.addEventListener("input", checkForChanges);
                        });
                    }

                    const notification =
                        document.querySelector(".notification");

                    if (notification) {
                        setTimeout(() => {
                            notification.classList.add("hide");
                        }, 2500);
                    }
                });
            </script>

</body>

</html>